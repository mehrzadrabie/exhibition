# Uploaded images only – never execute scripts here
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes -ExecCGI
