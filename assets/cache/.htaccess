<IfModule mod_headers.c>
  # layout-{version}.json never changes once written
  <FilesMatch "^layout-.*\.json$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # live seat availability: browsers must revalidate every time (cheap 304s)
  <FilesMatch "^seats-.*\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  <FilesMatch "^seats-.*\.json$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>
